{
  "name": "mashov-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:integration": "jest tests/integration --testEnvironment=node --forceExit --testTimeout=30000",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/testing": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@playwright/test": "^1.41.0",
    "@prisma/client": "^5.8.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/sanitize-html": "^2.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.12.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "tests/integration/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": "tsconfig.integration.json"
      }]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/frontend/src/$1"
    }
  }
}
