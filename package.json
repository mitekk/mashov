{
  "name": "mashov-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:tests",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:tests": "backend/node_modules/.bin/eslint --resolve-plugins-relative-to backend --config tests/.eslintrc.cjs \"tests/**/*.ts\" --max-warnings 0",
    "format": "npm run format:backend && npm run format:frontend && npm run format:tests",
    "format:backend": "npm --prefix backend run lint -- --fix",
    "format:frontend": "npm --prefix frontend run lint -- --fix",
    "format:tests": "backend/node_modules/.bin/eslint --resolve-plugins-relative-to backend --config tests/.eslintrc.cjs \"tests/**/*.ts\" --fix",
    "test:unit": "docker compose -f docker-compose.yml --profile test up --build --abort-on-container-exit --exit-code-from unit unit",
    "test:integration": "docker compose -f docker-compose.yml --profile test up --build --abort-on-container-exit --exit-code-from integration integration",
    "test:e2e": "docker compose -f docker-compose.yml --profile test up --build --abort-on-container-exit --exit-code-from e2e e2e"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/testing": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@playwright/test": "^1.41.0",
    "@prisma/client": "^5.8.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/sanitize-html": "^2.11.0",
    "@types/supertest": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.12.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "tests/integration/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.integration.json"
        }
      ]
    },
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/frontend/.next/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/frontend/src/$1"
    }
  }
}
