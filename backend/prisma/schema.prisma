generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HouseholdConnection {
  id                String    @id @default(cuid())
  schoolCode        Int
  schoolYear        Int
  username          String
  encryptedPassword String
  schoolName        String?
  upstreamUserId    String?
  cachedNewCount    Int       @default(0)
  mashovUniqueId    String?
  /// Mashov's trusted-device credential, encrypted with the same
  /// `EncryptionService` as `encryptedPassword`.
  ///
  /// This is what makes an MFA-protected account compatible with background
  /// sync. Sixteen cron tasks re-login by decrypting `encryptedPassword`; if
  /// every one of those re-logins re-opened the MFA challenge, the parent would
  /// sign in successfully once and then watch their data go stale overnight
  /// with no error anyone could see. `POST /api/loginDevice` with this value in
  /// a `devicePass` header is a re-login that skips the challenge.
  ///
  /// Mashov may rotate it on any login, so every login writes back whatever it
  /// returned. Keeping a stale one would fail the next re-login and drop sync
  /// back to a password that may no longer exist. See apis/post-api-loginDevice.md.
  devicePass        String?
  /// Set when we know the stored `encryptedPassword` no longer works -- today,
  /// when a password reset driven through our own recovery flow succeeded.
  ///
  /// Without it a reset breaks background sync silently: the crons keep
  /// decrypting a password Mashov has already replaced, and the parent sees
  /// data quietly stop updating. Surfaced on `MeSchool.credentialStale` so the
  /// app can say which school needs attention, which is what closes the loop
  /// for a multi-school household -- reset school B, sign in with A, and B must
  /// still say so. Cleared by any successful sign-in, which rewrites the
  /// credential anyway.
  credentialStaleAt DateTime?
  /// accessToken.userSchoolYears from the last login: the years this household
  /// actually has records for. Json rather than Int[] to match every other
  /// list in this schema and to stay additive for `prisma db push`.
  schoolYears       Json      @default("[]")
  lastLoginAt       DateTime?
  active            Boolean   @default(true)
  userId            String?
  /// Who asserted "this Mashov account is mine" by linking it, and when.
  /// Audit only -- never read for scoping. Adoption at sign-in means whoever
  /// holds either school's password reaches the merged household, so the one
  /// thing that must survive is a record of who opened that door. See ADR-0029.
  linkedByUserId    String?
  linkedAt          DateTime?
  /// A parent-chosen short name for this school. `null` means derive one from
  /// `schoolName`; see src/common/school-label.ts.
  displayLabel      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user AppUser? @relation(fields: [userId], references: [id])

  students         Student[]
  studentLinks     StudentConnection[]
  conversations    MailConversation[]
  messages         MailMessage[]
  notifications    NotificationEvent[]
  schoolActivities SchoolActivity[]
  parentProfiles   ParentProfile[]

  /// The identity of a Mashov account, and what makes adoption safe to race.
  /// `auth.service.ts` already treats (school, username) as the identity key
  /// and looked it up with `findFirst`; without the constraint two concurrent
  /// sign-ins can both decide they are creating the connection.
  ///
  /// Full, not partial (`WHERE active`): Prisma cannot express a partial index,
  /// so `prisma db push` would drop it on the next boot and the constraint
  /// would vanish silently. The duplicates `20261117000000` deactivated rather
  /// than deleted are collapsed by
  /// prisma/migrations/20261120000000_connection_duplicate_collapse, which the
  /// Dockerfile runs BEFORE `db push` for exactly this reason.
  @@unique([schoolCode, username])
  @@map("household_connection")
}

model AppUser {
  id                String                @id @default(uuid())
  mashovUserId      String                @unique
  /// The school of the credential that CREATED this row -- an origin marker,
  /// not a scope. A household can hold connections to several schools, so this
  /// answers "which account opened the account", nothing more. Read nowhere in
  /// src/ outside the upstream school list; never use it to decide what a user
  /// may see. Ownership lives on HouseholdConnection.userId.
  semel             Int
  /// Set when this AppUser's only connection was absorbed into another
  /// household, pointing at the household that now owns it. Sign-in follows it
  /// exactly one hop; the row is kept because AppSession and UserItemState
  /// reference it and the pointer is the audit trail. See ADR-0029.
  mergedIntoUserId  String?
  username          String
  displayName       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          AppSession[]
  connections       HouseholdConnection[]
  digestRecipients  DigestRecipient[]
  telegramLinkCodes TelegramLinkCode[]

  @@map("app_user")
}

model AppSession {
  id             String    @id @default(uuid())
  userId         String
  sessionToken   String    @unique
  expiresAt      DateTime
  lastActivityAt DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           AppUser   @relation(fields: [userId], references: [id])

  @@index([sessionToken])
  @@map("app_session")
}

model UserItemState {
  id         String   @id @default(uuid())
  userId     String
  itemType   String
  itemId     String
  isNew      Boolean  @default(true)
  isArchived Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemType, itemId])
  @@map("user_item_state")
}

model ParentProfile {
  id             String   @id @default(cuid())
  upstreamUserId String   @unique
  displayName    String?
  email          String?
  cellphone      String?
  detailsState   Int      @default(0)
  rawPayload     Json?
  updatedAt      DateTime @updatedAt

  /// Which connection fetched this profile. `upstreamUserId` is a per-school
  /// user id, so a two-school household has two rows -- both correct, and
  /// `settings.service.ts` used to pick between them with `findFirst`.
  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  @@index([householdConnectionId])
  @@map("parent_profile")
}

model Student {
  id          String   @id @default(cuid())
  studentGuid String   @unique
  privateName String
  familyName  String
  fullName    String
  classCode   String
  classNum    Int
  gender      String
  groupsRaw   Json?
  isActive    Boolean  @default(true)
  rawPayload  Json?
  updatedAt   DateTime @updatedAt

  // When this child was last present in a login roster. Absence from
  // `children[]` is the only signal that a child has left the school --
  // Mashov does not move them to `inactiveChildren` -- and without it they
  // stayed active forever while every per-student cron 403'd on them.
  lastSeenInRosterAt DateTime?

  /// Which connection to ask upstream for this child -- ROUTING ONLY.
  ///
  /// It is deliberately NOT the answer to "who may see this child": that is
  /// `links`, because a child can legitimately belong to more than one user
  /// (two parents, their own Mashov accounts, the same children). Carrying
  /// both jobs on this one column is what made the second parent to sync evict
  /// the first. See ADR-0031.
  ///
  /// Nullable permanently, not transitionally: the shared env-credential
  /// session legitimately writes unowned rows, and NULL means "ownership
  /// unknown, re-stamp on the next roster refresh" rather than "no owner". A
  /// required column would also make `prisma db push` impossible against the
  /// populated production tables.
  ///
  /// `onDelete: SetNull`, so a raw connection delete can never cascade away a
  /// child's history by accident -- `ConnectionService.deleteConnection` does
  /// that work explicitly and scoped.
  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  /// Every connection whose login roster lists this child -- the VISIBILITY
  /// edge. A user sees a child when any of their own connections links them.
  /// No links at all means "ownership unknown", which stays readable by any
  /// caller for the same reason the NULL stamp did. See ADR-0031.
  links StudentConnection[]

  @@index([isActive, lastSeenInRosterAt])
  @@index([householdConnectionId, isActive])
  @@map("student")
}

/// Which connections list a child, and therefore which users may see them.
///
/// `Student.studentGuid` is globally unique and every per-child table is keyed
/// by it alone, so a child's data is ONE shared copy. What was missing was the
/// visibility edge: two parents with their own Mashov accounts at one school
/// both legitimately list the same children (ADR-0016, PRD open question 2),
/// and a single `householdConnectionId` made whichever synced second evict the
/// other. See ADR-0031.
model StudentConnection {
  studentGuid           String
  householdConnectionId String
  /// When this connection first listed the child. Audit, and the field that
  /// distinguishes this from a prunable roster cache: a row here is a granted
  /// view, not an observation to be tidied away on a sync hiccup.
  firstSeenAt           DateTime @default(now())
  lastSeenInRosterAt    DateTime @default(now())

  student    Student             @relation(fields: [studentGuid], references: [studentGuid], onDelete: Cascade)
  connection HouseholdConnection @relation(fields: [householdConnectionId], references: [id], onDelete: Cascade)

  @@id([studentGuid, householdConnectionId])
  @@index([householdConnectionId])
  @@map("student_connection")
}

model NotificationEvent {
  id                     String    @id @default(cuid())
  /// A per-school counter, so two schools collide on it. Keyed with the
  /// owning connection below; on its own it meant the second school's
  /// notification silently replaced the first's.
  upstreamNotificationId Int?
  fingerprint            String?   @unique
  eventType              Int
  eventText              String
  eventKey               String?
  eventKey2              String?
  studentGuid            String?
  eventAt                DateTime
  addTime                DateTime?
  readTime               DateTime?
  parsedEventData        Json?
  rawPayload             Json
  updatedAt              DateTime  @updatedAt

  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  /// Named explicitly: the generated name is 67 characters, over Postgres's
  /// 63-byte identifier limit, so it would be silently truncated and drift
  /// `db push` from the committed migration -- the same trap
  /// digest_reported_item_dedup_key already documents.
  @@unique([householdConnectionId, upstreamNotificationId], map: "notification_event_connection_upstream_id_key")
  @@index([householdConnectionId])
  @@map("notification_event")
}

model MailConversation {
  id                    String    @id @default(cuid())
  conversationId        String    @unique
  subject               String
  senderNamePreview     String?
  sendTime              DateTime
  isUnread              Boolean   @default(false)
  hasDrafts             Boolean   @default(false)
  hasAttachments        Boolean   @default(false)
  preventReply          Boolean   @default(false)
  labels                Json      @default("[]")
  rawPayload            Json?
  lastFetchedAt         DateTime  @default(now())
  // The sendTime of the newest message the user had when they marked this
  // conversation read locally, or null if they never did. Mashov documents no
  // markAsRead endpoint, so upstream keeps reporting the message unread and the
  // next inbox walk would restore isUnread: true -- the badge bouncing back within
  // 7 minutes of the user acting. Stored as a message sendTime rather than now():
  // Mashov timestamps are naive and parsed in the container's zone, so a UTC now()
  // would sit 2-3h behind the instants it is compared against and clear the
  // override for any mail read soon after it arrived.
  locallyReadThroughAt  DateTime?
  // Set when the user explicitly marks the conversation unread, cleared when they mark
  // it read or archive it. MailInboxTask's reconciliation sweep skips these rows: for a
  // conversation upstream has stopped returning, the local row is the only record of
  // what the user wanted, and without this the sweep would flip it back to read every
  // 7 minutes -- the same bouncing state locallyReadThroughAt exists to prevent, in the
  // opposite direction.
  locallyMarkedUnreadAt DateTime?

  messages MailMessage[]

  /// The mailbox this conversation came from. `conversationId` is a global
  /// UUID, so the table is the union of every household's mail and nothing
  /// could tell the rows apart -- which is why MailInboxTask refused to run its
  /// reconciliation sweep above one active connection at all.
  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  @@index([householdConnectionId, isUnread])
  @@index([householdConnectionId, sendTime])
  @@map("mail_conversation")
}

model MailMessage {
  id                String   @id @default(cuid())
  messageId         String   @unique
  conversationId    String
  senderId          String
  senderName        String
  subject           String
  bodyHtmlSanitized String?
  bodyTextPreview   String?
  sendTime          DateTime
  isNew             Boolean  @default(false)
  recipients        Json     @default("[]")
  files             Json     @default("[]")
  preventReply      Boolean  @default(false)
  sentViaEmail      Boolean  @default(false)
  sentViaSms        Boolean  @default(false)
  rawPayload        Json?

  conversation MailConversation @relation(fields: [conversationId], references: [conversationId])

  /// Denormalised from the conversation rather than reached through the
  /// relation. The column buys a direct connection resolve from a bare
  /// `messageId` for an attachment download, and symmetry with the conversation
  /// row the same upsert loop already writes. Cost: one TEXT per message,
  /// written by code already in that loop.
  ///
  /// It is NOT what the unlink deletes by: a message written by the
  /// conversation-detail fetch carried no stamp at all before R2, so the unlink
  /// reaches messages through `conversation` and keeps this column only as a
  /// second arm. See ConnectionService.prepareConnectionDeletion.
  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  @@index([householdConnectionId])
  /// Postgres does not index a foreign key's referencing column. Without this,
  /// both the unlink's relation-filtered delete and the FK check on
  /// `mail_conversation`'s delete sequential-scan this table under lock.
  @@index([conversationId])
  @@map("mail_message")
}

model HomeworkItem {
  id           String   @id @default(cuid())
  studentGuid  String
  lessonId     Int
  groupId      Int
  lessonDate   DateTime
  lesson       Int
  subjectName  String
  homeworkText String
  remark       String?
  files        Json     @default("[]")
  rawPayload   Json?
  // Mashov school year, named by its ending calendar year (2027 = Sep 2026 -
  // Jun 2027). Declared with a default so `prisma db push` adds it
  // non-destructively to the populated production tables; the backfill script
  // in backend/scripts/backfill-school-year.ts rewrites 0 -> 2026.
  schoolYear   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([studentGuid, schoolYear, lessonId])
  // Two readers, two shapes, and neither index serves the other. The feed
  // filters on schoolYear with no studentGuid, so the compound uniques above
  // (all leading on studentGuid) cannot serve its range predicate. The digest
  // checker always has a studentGuid and scans a date range within it.
  @@index([schoolYear, lessonDate])
  @@index([studentGuid, schoolYear, lessonDate])
  @@map("homework_item")
}

model BehaviorItem {
  id             String   @id @default(cuid())
  studentGuid    String
  lessonId       Int
  groupId        Int
  eventCode      Int
  achvaCode      Int
  achvaName      String
  classification String   @default("neutral")
  justifiable    Boolean  @default(false)
  lessonDate     DateTime
  lesson         Int?
  subject        String
  reporter       String
  remark         String?
  justification  String?
  eventAt        DateTime
  rawPayload     Json?
  schoolYear     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([studentGuid, schoolYear, lessonId, eventCode])
  // As on homework_item: the feed's year-wide scan and the digest's per-child
  // scan need different leading columns. Two dates as well -- lessonDate is
  // when the event happened, eventAt when the teacher recorded it, and the
  // digest windows on either, so a teacher entering yesterday's absence this
  // afternoon is still today's news.
  @@index([schoolYear, eventAt])
  @@index([studentGuid, schoolYear, lessonDate])
  @@index([studentGuid, schoolYear, eventAt])
  @@map("behavior_item")
}

model SubjectEnrollment {
  id               String   @id @default(cuid())
  studentGuid      String
  groupId          Int
  groupName        String
  subjectName      String
  teachers         Json     @default("[]")
  inactiveTeachers Json     @default("[]")
  weeklyHours      Int      @default(0)
  lessonsCount     Int      @default(0)
  rawPayload       Json?
  schoolYear       Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([studentGuid, schoolYear, groupId])
  @@map("subject_enrollment")
}

/// A school's own behaviour taxonomy, NOT global reference data.
///
/// `apis/get-api-achvas.md` carries `teacherId` and `commonBehaveId`: the codes
/// are school-local, and `justifiable` is the school's own policy on whether an
/// absence excuses itself. Keyed by `schoolCode` rather than by connection
/// because it is school-level -- two parents at one school must not duplicate
/// it -- and because `BehaviorClassifierService` answers "is this absence
/// justifiable" from it and was answering from whichever school wrote last.
model BehaviorTypeReference {
  id               String   @id @default(cuid())
  schoolCode       Int      @default(0)
  code             Int
  name             String
  displayOrder     Int      @default(0)
  justifiable      Boolean  @default(false)
  hidden           Boolean  @default(false)
  showInBehave     Boolean  @default(true)
  hideFromStudents Boolean  @default(false)
  rawPayload       Json?
  updatedAt        DateTime @updatedAt

  @@unique([schoolCode, code])
  @@map("behavior_type_reference")
}

model MessageBoardItem {
  id             String   @id @default(cuid())
  studentGuid    String
  eventId        Int
  eventText      String
  expirationDate DateTime
  inSite         Boolean  @default(false)
  rawPayload     Json?
  schoolYear     Int      @default(0)
  /// When this row was first created locally -- the only thing here that can
  /// mean "new".
  ///
  /// Mashov's message board payload carries no creation date at all, and
  /// `updatedAt` churns on every 06:00 upsert, so neither can distinguish a
  /// notice posted this morning from one that has been up since September.
  /// Written only on create: the sync task's `update` branch must never touch
  /// it, or every notice becomes new again daily.
  ///
  /// Defaulted so `prisma db push` can add it to the populated production
  /// table -- which fills every existing row with the deploy timestamp, making
  /// the whole current board look first-seen at once. The migration backfills
  /// those from `updatedAt`, and the Dockerfile executes it, because
  /// `db push` applies no data statement.
  firstSeenAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentGuid, schoolYear, eventId])
  /// The digest checker's arm: this child's notices first seen in the last few
  /// days, seven times a day.
  @@index([studentGuid, schoolYear, firstSeenAt])
  @@map("message_board_item")
}

model SyncRun {
  id                    String    @id @default(cuid())
  source                String
  status                String
  startedAt             DateTime
  endedAt               DateTime?
  fetchedCount          Int?
  createdCount          Int?
  updatedCount          Int?
  // mail_counts only: the two numbers whose disagreement is the whole bug, kept
  // queryable without container logs. fetchedCount is not repurposed for them --
  // it carries the constant 1 for that task and honest column names beat a comment.
  upstreamCount         Int?
  localCount            Int?
  errorMessage          String?
  householdConnectionId String?

  // FreshnessService.getAllSourceHealth() table-scanned this; it had no index at
  // all and grows without bound.
  @@index([source, startedAt])
  // getLatestSuccessfulRuns() filters on status and orders by endedAt, which
  // the index above cannot serve.
  @@index([status, endedAt])
  // The caller-scoped source-health reads filter on householdConnectionId
  // first. Neither index above is leading on it, so without these two Postgres
  // falls back to a sequential scan plus a sort -- on the same unbounded table
  // whose full reads timed out this endpoint once already.
  @@index([householdConnectionId, source, startedAt])
  @@index([householdConnectionId, status, endedAt])
  @@map("sync_run")
}

model RecipientDirectory {
  id          String   @id @default(cuid())
  value       String
  valueType   String
  targetType  String
  displayName String
  comment     String?
  rawPayload  Json?
  updatedAt   DateTime @updatedAt

  @@map("recipient_directory")
}

model TimetableEntry {
  id          String   @id @default(cuid())
  studentGuid String
  groupId     Int
  day         Int
  lesson      Int
  roomNum     String   @default("")
  weeks       Int      @default(-1)
  groupName   String
  subjectName String
  teachers    Json     @default("[]")
  schoolYear  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([studentGuid, schoolYear, day, lesson])
  @@index([studentGuid])
  @@map("timetable_entry")
}

/// The school's bell schedule: when each lesson period starts and ends.
///
/// Keyed by school rather than by student, because that is what the upstream
/// resource is -- `GET /api/bells` takes no student guid and answers for the
/// session's `semel`. Two children at the same school share one set of rows,
/// and the sync task makes one upstream call for them (ADR-0037).
///
/// Times are stored as "HH:MM" strings, not DateTime: a bell time is a wall
/// clock reading with no date and no zone, and a DateTime column would invite
/// exactly the UTC shift that would move 08:15 to 06:15.
///
/// Breaks are NOT stored. Recess is the gap between one period's end and the
/// next period's start; it is derived on read by
/// `backend/src/common/bells/derive-breaks.ts`.
model BellSchedule {
  id         String   @id @default(cuid())
  schoolCode Int
  schoolYear Int
  lesson     Int
  startTime  String
  endTime    String
  updatedAt  DateTime @updatedAt

  @@unique([schoolCode, schoolYear, lesson])
  @@map("bell_schedule")
}

// ---------------------------------------------------------------------------
// Digest: per-child daily activity briefing pushed to a parent's messaging app.
// ---------------------------------------------------------------------------

/// Who receives a child's digest, and on which channel. These rows are also the
/// de-facto child -> parent ownership mapping: `Student` has no userId FK (children
/// are global and every cron iterates the whole active roster), so a child gets a
/// digest only if an enabled recipient row exists for it. That makes delivery
/// strictly opt-in, the right default for pushing a child's behavior data to a
/// third party. See ADR-0025 for the trade-off this accepts.
/// An early-release request a parent filed for a child.
///
/// Parent-submitted, not school-generated: `contactGuid` upstream names the
/// parent who wrote it, and is deliberately NOT a column here -- nothing in the
/// app needs it and it is a third party's identifier. The digest reports only a
/// release scheduled for today or tomorrow, as a reminder; echoing a request
/// back to the parent who filed it on the day they filed it is not news.
model StudentRelease {
  id              String    @id @default(cuid())
  studentGuid     String
  // Mashov's own release id, stable per request.
  releaseId       Int
  schoolYear      Int       @default(0)
  // The release day, UTC midnight of the Jerusalem date.
  releaseDate     DateTime
  // Time of day the child leaves, as Mashov sends it: "11:30:00".
  startHour       String
  // The parent's free text. Rendered back to them; never sent to the model.
  remark          String?
  status          Int       @default(0)
  isDeleted       Boolean   @default(false)
  requestEditTime DateTime?
  rawPayload      Json?
  updatedAt       DateTime  @updatedAt

  @@unique([studentGuid, schoolYear, releaseId])
  @@index([studentGuid, releaseDate])
  @@map("student_release")
}

/// A school activity needing a parent's consent -- a field trip, a show.
///
/// Household-scoped, not per child: `/api/schoolActivities/permitted` takes no
/// studentGuid, and `isAnswered` is the answer of the parent whose session
/// fetched it. The row is therefore keyed by `userId` as well as the activity
/// id, and `userId` is required: a row with no owner could not answer the
/// question "has this parent signed it yet", which is the only reason the
/// digest reports it.
model SchoolActivity {
  id                String    @id @default(cuid())
  userId            String
  // Mashov's own activity id, shared by every parent in the school.
  activityId        Int
  schoolYear        Int       @default(0)
  // 1 = field trip, 2 = recurring/farm, 4 = theatre or show.
  activityType      Int       @default(0)
  title             String
  /// The consent letter with its HTML stripped. Kept for a future UI; never
  /// sent to the model, which gets the title and the dates only. The letter
  /// routinely names staff and other children.
  descriptionText   String?
  activityStartDate DateTime
  activityEndDate   DateTime
  /// The deadline for answering, and what makes an activity reportable.
  ///
  /// Nullable because a school may publish an activity with no response
  /// deadline, and the capture (`apis/get-api-schoolActivities-permitted.md`)
  /// marks the field required while the live payload omits it. Throwing on the
  /// absence failed the whole sync task on every refresh at both schools, which
  /// pinned the refresh envelope at `partial` permanently (T13 finding 5). An
  /// undated activity is not reportable -- the digest's `gte`/`lt` filter never
  /// matches NULL -- but it is storable, and the UI shows it as `לא זמין`.
  endAnswerDate     DateTime?
  isAnswered        Boolean   @default(false)
  createTime        DateTime?
  rawPayload        Json?
  updatedAt         DateTime  @updatedAt

  /// `activityId` is a per-school counter -- it is literally `1` in the
  /// captured payload -- and `userId` is now the merged household, so without
  /// the connection in the key one school's consent request overwrites the
  /// other's.
  householdConnectionId String?
  connection            HouseholdConnection? @relation(fields: [householdConnectionId], references: [id], onDelete: SetNull)

  /// Named explicitly, for the same reason as above: the generated name is 70
  /// characters.
  @@unique([userId, householdConnectionId, schoolYear, activityId], map: "school_activity_user_connection_year_activity_key")
  @@index([userId, endAnswerDate])
  @@index([householdConnectionId])
  @@map("school_activity")
}

model DigestRecipient {
  id          String   @id @default(cuid())
  userId      String
  studentGuid String
  /// 'telegram' today; the DigestSender interface allows more.
  channel     String
  /// Telegram chat id.
  address     String
  displayName String?
  enabled     Boolean  @default(true)
  /// Items dated before this are never reported - stops the first run blasting a
  /// backlog of the whole school year.
  activeFrom  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `userId` leads the key because a subscription belongs to a parent, not to
  /// a chat. Without it, two parents linking one family group chat for one
  /// child shared a single row: the second parent's START found the first's
  /// row and only flipped `enabled`, so they had no row of their own to see,
  /// toggle or delete.
  @@unique([userId, studentGuid, channel, address])
  @@index([studentGuid, enabled])
  @@index([userId])
  @@map("digest_recipient")
}

/// A one-time code that binds a parent's Telegram chat to their AppUser.
///
/// The parent gets `https://t.me/<bot>?start=<code>` and presses START; the
/// long poller reads `message.chat.id` out of that update and matches the code
/// here. Postgres rather than Redis for two reasons: ADR-0017 forbids durable
/// state in Redis, and this cache runs `allkeys-lru` with no persistence, so an
/// evicted code would be a START that matches nothing and a parent stuck on the
/// wizard's third step with no way forward.
///
/// The code is a credential: guessing one binds the guesser's own chat to a
/// victim's userId and starts streaming that family's children's behaviour
/// reports to a stranger. Hence 16 random bytes, single-use via `consumedAt`,
/// a short TTL, and a throttled mint route. See ADR-0033.
model TelegramLinkCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  userId             String
  /// The children this link was minted for -- the parent's step-2 choice. The
  /// START arrives server-side with no browser attached, so the intent has to
  /// travel on the row. Re-validated against the caller's visibility set at
  /// consume time, because the roster can change in between.
  studentGuids       String[]
  expiresAt          DateTime
  /// Set in the same conditional update that matches the code, which is what
  /// makes a replayed START a no-op rather than a second binding.
  consumedAt         DateTime?
  /// Telegram chat id, written at consume time. The wizard's poll reads this
  /// row to know the link resolved.
  chatId             String?
  confirmationSentAt DateTime?
  confirmationError  String?
  createdAt          DateTime  @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("telegram_link_code")
}

/// One row per (item, reason) already reported to a parent. This is the dedup
/// ledger; ADR-0017 forbids durable state in Redis, so the uniqueness of these rows
/// is what makes the digest at-most-once.
model DigestReportedItem {
  id String @id @default(cuid())
  /// The subscribing parent this row was reported to. One run per (child,
  /// user), each with its own ledger: two parents of one child are told the
  /// same per-child news independently, and one of them unlinking their school
  /// must not take the other's dedup state with it.
  ///
  /// Declared with a default on purpose: production's schema comes from
  /// `prisma db push --accept-data-loss`, and adding a required column with no
  /// default to a populated table is not executable under that flag. The
  /// migration backfills the real value; see
  /// prisma/migrations/20261124000000_digest_per_user/migration.sql, and the
  /// same reasoning written out in 20261117000000_school_year_scoping.
  userId          String    @default("")
  studentGuid     String
  /// 'behavior' | 'homework_new' | 'homework_due' - the *reason* the item was
  /// reported. Distinct types let one homework row be reported once as newly
  /// assigned and later as estimated-due.
  itemType        String
  /// HomeworkItem.id or BehaviorItem.id.
  itemId          String
  /// sha256 of the fields actually shown to the parent. Part of the unique key on
  /// purpose: a teacher editing homework text yields a new hash, hence a new row,
  /// hence a legitimate re-report as changed. A stable hash means the row already
  /// exists, i.e. already reported - so no separate "has it changed" bookkeeping.
  /// Never derive novelty from `updatedAt`: the 12-minute sync tasks upsert
  /// identical rows and churn it on every pass.
  contentHash     String
  /// School day the report covered - retention and audit.
  reportedFor     DateTime  @db.Date
  claimedAt       DateTime  @default(now())
  /// Which run owns this claim. A count from `createMany` says how many rows you
  /// won but never which, so ownership has to be readable back: the claimer
  /// stamps its own run id and then reads its own rows. Without it, two runs can
  /// each believe they own an item and send it twice, and a failing run can
  /// delete a claim another run is holding.
  claimedBy       String?
  /// Set only after a successful send. A row left unconfirmed past 30 minutes is a
  /// crashed claim and is taken over by the next run.
  confirmedAt     DateTime?
  /// For a `homework_due` item the model resolved to a deadline that was not
  /// tomorrow: the date it resolved to. The row stays (so the model is not asked
  /// again every hour) and the checker re-admits the item on the day that date
  /// *is* tomorrow. A confirmed row with this null means fully reported; with it
  /// set, it means deferred to that date. Without this column the only options
  /// are burying the deadline or re-resolving it on every run for a fortnight.
  resolvedDueDate DateTime? @db.Date
  deliveryId      String?

  /// Named explicitly: the generated name would exceed Postgres's 63-character
  /// identifier limit and be silently truncated, drifting `db push` from the
  /// committed migration.
  @@unique([userId, studentGuid, itemType, itemId, contentHash], map: "digest_reported_item_dedup_key")
  @@index([studentGuid, reportedFor])
  /// The checker's hottest query: one lookup per child per run against the
  /// hashes it just computed. The dedup unique leads with userId, so without
  /// this Postgres scans every row that child has ever had.
  @@index([userId, studentGuid, contentHash])
  /// The consent-form arm of `dropAlreadyReported` omits `studentGuid` on
  /// purpose -- form dedup is household-wide across siblings -- so it can
  /// otherwise use only the `userId` prefix of the index above.
  @@index([userId, contentHash])
  @@map("digest_reported_item")
}

/// One row per one-time data migration that must never run a second time.
///
/// A table rather than a constant, and declared here rather than only in the
/// migration file, because `prisma db push --accept-data-loss` -- which is how
/// production gets its schema, on every boot -- DROPS a table the schema does
/// not mention. A marker that push deletes is a marker that resets on every
/// restart, which is no marker at all.
///
/// Only statements that are unsafe to repeat need this. Every other statement
/// in prisma/migrations is written to be idempotent, which is cheaper and
/// needs no bookkeeping.
model DataBackfill {
  /// A stable name for the statement, e.g. "digest-per-user-ledger-copy".
  id        String   @id
  appliedAt DateTime @default(now())

  @@map("data_backfill")
}

/// The digest's own run log. Deliberately NOT recorded in `sync_run`: a digest is
/// not a sync source, and sync.controller.ts counts distinct successful sources
/// against a hardcoded TOTAL_SYNC_SOURCES, so digest rows there would silently skew
/// the freshness percentage the dashboard shows. Every run writes a row, including
/// `skipped_empty` - it is the only way to tell a quiet day from a broken job.
/// One row per (mail message, chat) already notified about.
///
/// A dedicated model rather than a `DigestReportedItem` with a sentinel guid.
/// `DigestReportedItem.studentGuid` is required with no default, and its
/// consent-form dedup arm queries `{userId, contentHash}` with NO studentGuid
/// at all -- household-wide on purpose -- so any sentinel value would collide
/// with that arm and suppress real forms.
///
/// Keyed per `address` as well as per user: a chat linked after some mail
/// arrived must not be silenced by another chat's history. The cost is one row
/// per message per linked chat, which the retention sweep bounds.
model MailNotifiedMessage {
  id             String    @id @default(cuid())
  /// The subscribing parent. Mail is household-scoped, so this is who the
  /// `householdMailScope` read was run as.
  userId         String
  /// Matches DigestRecipient.channel / .address.
  channel        String
  address        String
  /// MailMessage.messageId -- Mashov's own id, not our cuid.
  messageId      String
  /// Carried so the ledger can be read without joining mail_message, and so a
  /// summary message can claim a run's rows by conversation.
  conversationId String
  /// sha256 over the fields the parent will see. In the unique key for the
  /// same reason as DigestReportedItem's: an edited subject or body is a new
  /// hash, hence a new row, hence a legitimate re-notification.
  contentHash    String
  /// The Jerusalem calendar day the notification covered -- retention and audit.
  notifiedFor    DateTime  @db.Date
  claimedAt      DateTime  @default(now())
  /// Which run owns this claim; see DigestReportedItem.claimedBy for why a
  /// createMany count cannot answer that.
  claimedBy      String?
  /// Set only after a successful send. Unconfirmed past STALE_CLAIM_MS means
  /// the run that held it died before sending, and the message comes back.
  confirmedAt    DateTime?

  @@unique([userId, channel, address, messageId, contentHash], map: "mail_notified_message_dedup_key")
  @@index([userId, claimedAt])
  @@map("mail_notified_message")
}

model DigestDelivery {
  id String @id @default(cuid())
  /// Whose run this was. `GET /digest/deliveries` scopes on it: the row holds
  /// `messageText`, which now contains that parent's own unanswered consent
  /// forms, so scoping by child let the other parent of a shared child read
  /// it. Defaulted for the same `db push` reason as DigestReportedItem.userId.
  userId         String   @default("")
  /// Null for a run that is not about one child. Household mail is the first
  /// such run: it is scoped to the parent's whole inbox, so there is no child
  /// to name, and a sentinel would be read as a real guid by every query here.
  /// Relaxed rather than split into a second table so one history answers
  /// "what have you sent me", which is what this table is for.
  studentGuid    String?
  reportFor      DateTime @db.Date
  runAt          DateTime @default(now())
  /// 'sent' | 'skipped_empty' | 'failed' | 'dry_run'
  status         String
  /// Which feature wrote the row: 'digest' (the per-child daily report) or
  /// 'inbox' (a household mail notification). Defaulted so `prisma db push`
  /// can add it to the populated production table, and so every row already
  /// there reads as what it is.
  kind           String   @default("digest")
  itemCount      Int      @default(0)
  recipientCount Int      @default(0)
  channel        String?
  /// What was actually sent, for support.
  messageText    String?
  usedLlm        Boolean  @default(false)
  errorMessage   String?

  @@index([studentGuid, reportFor])
  /// `listDeliveries` filters on userId and orders by `runAt desc`, and the
  /// table now grows by a row per run per subscribing user.
  @@index([userId, runAt])
  @@map("digest_delivery")
}

/// A parent's feedback report. Write-only: there is no read path in the app,
/// and nothing here is ever shown back to the parent.
///
/// Every row is a self-contained SNAPSHOT, not a set of references. The merge
/// retires an `app_user` into another household (ADR-0029) and unlink clears
/// `HouseholdConnection.userId` (ADR-0032), so a row holding only ids stops
/// being interpretable exactly when a two-school household is involved -- the
/// case most worth reading. Hence the denormalized copies of the parent
/// (`mashovUserId`, `username`, `displayName`) and of their schools
/// (`schoolsSnapshot`). See ADR-0044.
///
/// Deliberately FK-free, with no back-relation on AppUser: production boots
/// with `prisma db push`, so the committed migration.sql must be idempotent,
/// and Postgres has no `ADD CONSTRAINT IF NOT EXISTS`. An FK would also block
/// deleting an `app_user` whose snapshot is the whole point. Precedent:
/// `MailNotifiedMessage.userId`.
model Feedback {
  id              String   @id @default(uuid())
  /// The AppUser who sent it. A plain String, see above.
  userId          String
  /// One of FEEDBACK_SUBJECTS in src/feedback/feedback.service.ts.
  subject         String
  /// The parent's own wording, only when `subject` is 'other'. The service
  /// nulls it for every other subject so a stray client value cannot persist.
  subjectOther    String?
  /// Where to reply, pre-filled from the Mashov profile and editable. Null
  /// when the parent cleared it.
  contactEmail    String?
  content         String
  /// Reproduction context, captured by the client. Path only -- the client
  /// sends no query or hash. The path itself does carry a child guid on the
  /// child routes (`/children/<guid>`), deliberately: it is the reporting
  /// parent's own child, and without it a report names no child at all.
  pagePath        String?
  /// Read from the request header, not from the body. Truncated to 512 chars.
  userAgent       String?
  viewportWidth   Int?
  viewportHeight  Int?
  /// The build the parent was running. Null when neither the client nor the
  /// server knows it.
  appVersion      String?
  mashovUserId    String
  username        String
  /// `parentDisplayName()`'s output, so one child's class tag is not persisted
  /// into every row of a multi-child household.
  displayName     String
  /// The parent's active connections at send time:
  /// `[{ id, schoolCode, schoolName, label, schoolYear }]`. Json rather than a
  /// typed array to match HouseholdConnection.schoolYears and stay additive
  /// for `db push`; defaulted so reads never handle null.
  schoolsSnapshot Json     @default("[]")
  createdAt       DateTime @default(now())

  /// The per-user rate limit counts a user's rows in the last hour.
  @@index([userId, createdAt])
  /// Reading the table is "newest first".
  @@index([createdAt])
  @@map("feedback")
}

/// One row per COMPLETED password reset driven through our recovery flow.
///
/// We are mutating a password on a third-party system on behalf of someone we
/// have not authenticated -- whoever completed the flow proved control of the
/// school-registered email or phone, not ownership of an AppUser household. The
/// attempt caps protect us from being an abuse amplifier as much as they
/// protect the parent, and this table is the trail that makes an abuse pattern
/// visible after the fact. See ADR-0042.
///
/// What is deliberately NOT here: the recovery code, the new password, and the
/// raw ID number. The ID number is stored only as a SHA-256 hash, which is
/// enough to count resets per identity and to join two attempts together
/// without parking a national identifier in a support-readable table.
model CredentialRecoveryAudit {
  id String @id @default(cuid())
  /// Mashov `semel`.
  schoolCode   Int
  /// SHA-256 hex of the ID number the reset was performed for. Never the ID.
  idNumberHash String
  /// The caller's IP, as the login rate limiter sees it.
  ip           String
  at           DateTime @default(now())

  /// "how many resets at this school lately" -- the abuse-amplifier question.
  @@index([schoolCode, at])
  /// "how many resets for this identity lately".
  @@index([idNumberHash, at])
  @@map("credential_recovery_audit")
}
