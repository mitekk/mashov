# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/mashov
DB_NAME=mashov
DB_USER=postgres
DB_PASSWORD=postgres

# Mashov credentials
MASHOV_YEAR=2026

# Security
ENCRYPTION_KEY=your_64_hex_chars_here

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3001

# Feature flags
FEATURE_DAILY_BEHAVE=false
FEATURE_OUT_BEHAVE=false

# Redis
REDIS_URL=redis://redis:6379

# Session
SESSION_LIFETIME_DAYS=30
SESSION_SECURE_COOKIE=false


# --- Mashov egress -----------------------------------------------------------
# Mashov blocks datacenter IPs, so production sends Mashov calls through an HTTP
# proxy on a host with a residential address. Leave unset for local dev.
# See README "Reaching Mashov" and ops/install-egress-proxy.sh.
MASHOV_BASE_URL=https://web.mashov.info
HTTPS_PROXY=

# --- Timeouts (all optional; defaults shown) ---------------------------------
# Wall-clock bound per Mashov request. Enforced with AbortSignal, because a
# blackholed proxy means axios' own `timeout` never arms. See ADR-0023.
MASHOV_TIMEOUT_MS=10000
# Bound per backend call from the frontend /api/v1/* proxy. Keep above
# MASHOV_TIMEOUT_MS and well below the CDN's ~100s.
PROXY_TIMEOUT_MS=15000
# Bound for /api/v1/sync/*, which runs every sync task before responding.
PROXY_SLOW_TIMEOUT_MS=90000
# Bound for attachment downloads (/api/v1/{mail,children}/**/files/*).
PROXY_ATTACHMENT_TIMEOUT_MS=45000

# --- Tests only --------------------------------------------------------------
# 1 lets the e2e browser skip the auth guard. MUST stay 0 outside tests.
ENABLE_E2E_AUTH_BYPASS=0
# --- Per-child daily digest -> Telegram (see ADR-0025, ADR-0026) ---
# Both switches are inert by default: the cron is off, and even when on the
# dry run renders and logs without messaging anybody.
DIGEST_ENABLED=false
DIGEST_DRY_RUN=true
DIGEST_TIMEZONE=Asia/Jerusalem
DIGEST_DUE_LOOKBACK_DAYS=14
DIGEST_LLM_MODEL=claude-opus-5-5
DIGEST_LLM_TIMEOUT_MS=30000
# Secrets. Leave blank here; never commit real values.
# Without ANTHROPIC_API_KEY the digest still sends, using deterministic Hebrew.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
DIGEST_NEW_LOOKBACK_DAYS=3
DIGEST_LLM_EFFORT=low
DIGEST_ACTIVITY_WINDOW_DAYS=7
# Host port the Postgres container publishes on. Containers always reach it
# as db:5432, so this moves the host side only — set it when something else
# already holds 5432.
DB_PORT=5432

# ─── Kill switches (both default to on; unset is on) ───────────────────────

# Freezes the mail unread reconciliation sweep. `false` holds the inbox badge
# in place while a wrong count is diagnosed -- the walk and the
# per-conversation derivation keep running, only the orphan sweep stops.
# Anything else, including unset, leaves it on.
MAIL_SWEEP_ENABLED=true

# Whether signing in with a school's credentials attaches to the household
# that already linked it, and whether a household merge is offered at all.
# `false` restores the pre-merge behaviour, where each school's Mashov account
# gets its own household -- which makes linking a second school a dead end.
# See ADR-0029 and ADR-0032.
MASHOV_ENABLE_SCHOOL_LINK_ADOPTION=true

# Telegram's HTML parse mode: bold section titles, quoted teacher remarks, and
# items that link to the page they are about. `false` sends the same messages
# flat, with the tags stripped -- so a parse problem in production is a restart
# rather than a deploy. Every template escapes what it interpolates and the
# senders retry a parse complaint as plain text, so this should stay on. See
# ADR-0047.
TELEGRAM_HTML_ENABLED=true

TELEGRAM_LINK_CODE_TTL_MINUTES=15
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_POLL_ENABLED=true
FEEDBACK_TELEGRAM_BOT_TOKEN=

BACKEND_PORT=3001
FRONTEND_PORT=3000