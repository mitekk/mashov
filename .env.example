# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/mashov
DB_NAME=mashov
DB_USER=postgres
DB_PASSWORD=postgres

# Mashov credentials
MASHOV_SEMEL=your_school_semel
MASHOV_YEAR=2026
MASHOV_USERNAME=your_id_number
MASHOV_PASSWORD=your_password

# Security
ENCRYPTION_KEY=your_64_hex_chars_here

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3001

# Feature flags
FEATURE_DAILY_BEHAVE=false
FEATURE_OUT_BEHAVE=false

# Redis
REDIS_URL=redis://redis:6379

# Session
SESSION_LIFETIME_DAYS=30
SESSION_SECURE_COOKIE=false
